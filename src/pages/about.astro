---
import '../styles/global.css';


const pageTitle = "About Me";

const identity = {
	firstName: "Vincent",
	hobbies: ["making cool things", "minecraft", "music"],
};

const skills = ["Onshape", "SolidWorks", "Fusion 360 CAM", "Java", "Python"];

const skillColor = "crimson";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>

		<style define:vars={{skillColor}}>
			h1 {
        	color: crimson;
        	font-size: 4rem;
      		}
			.skill {
				color: var(--skillColor);
				font-weight: bold;
			}
		</style>
	</head>
	<body>
        <a href="/">Home</a>
        <a href="about">About</a>
        <a href="./projects">Projects</a>
        <a href="./devlogs">Devlogs</a>


		<h1>{pageTitle}</h1>
        <h2>and some more info about me :)</h2>

		<ul>
			<li>My name is {identity.firstName}.</li>
			{identity.hobbies.length >=2 && 
				<li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}</li>
			}
		</ul>
		<p>My skills are:</p>
		<ul>
			{skills.map((skill) => <li class="skill">{skill}</li>)}
		</ul>

        <p>Working on building this website up for all my projects and certs</p>
        <p> coming soon 🤣</p>
	</body>
</html>
